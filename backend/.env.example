# ============================================================
#  Crypto Carrom — Backend Environment
#  Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ---- App ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME=crypto-carrom

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# ---- Database (PostgreSQL / Prisma) ----
DATABASE_URL=postgresql://carrom:carrom@localhost:5432/carrom?schema=public

# ---- JWT ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=crypto-carrom

# ---- Bcrypt ----
BCRYPT_SALT_ROUNDS=12

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---- Cookies ----
COOKIE_SECRET=change-me-cookie-secret
COOKIE_DOMAIN=localhost

# ---- Socket.IO ----
SOCKET_PATH=/socket.io
SOCKET_PING_INTERVAL=25000
SOCKET_PING_TIMEOUT=20000

# ---- Logging ----
LOG_LEVEL=debug

# ---- Firebase Admin (server-side token verification) ----
# From Firebase console → Project settings → Service accounts → Generate new private key.
# SECRET — never commit. Keep the \n escaping in the private key.
FIREBASE_PROJECT_ID=crypto-carrom
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Mail (placeholder for email verification / reset) ----
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Crypto Carrom <no-reply@crypto-carrom.local>"

# ---- Crypto / Web3 (Phase 5 — placeholders only) ----
CRYPTO_ENABLED=false
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CHAIN_ID=
TOKEN_CONTRACT_ADDRESS=
